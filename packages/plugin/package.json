{
  "name": "@designforge/plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:code\" \"pnpm run dev:ui\"",
    "dev:code": "vite build --watch --config vite.config.ts",
    "dev:ui": "vite build --watch --config vite.config.ui.ts",
    "build": "pnpm run build:code && pnpm run build:ui",
    "build:code": "vite build --config vite.config.ts",
    "build:ui": "vite build --config vite.config.ui.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.99.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
